// The Words of Jesus in the Gospel of John — mobile reading edition
// Page: 100 × 200 mm (phone-shaped), single column, serif.
// Data: build/content.typ, generated by tools/build.py.

#import "content.typ": book

#let accent = rgb("#7a1f1a")
#let ink = rgb("#1a1714")
#let muted = rgb("#6b635b")
#let rule-c = rgb("#ded7cc")
#let paper = rgb("#fdfcf9")
#let dark = rgb("#17130f")
#let cream = rgb("#f3ece1")


#set document(
  title: "The Words of Jesus in the Gospel of John",
  author: "Compiled from the World English Bible (public domain)",
  keywords: ("Gospel of John", "Jesus", "red letter", "World English Bible"),
)

#set text(font: ("Charter", "Iowan Old Style", "Palatino"), size: 10.5pt, fill: ink,
  lang: "en", region: "us", hyphenate: true)
#set par(justify: true, leading: 0.72em, spacing: 0.72em)
#set page(
  width: 100mm, height: 200mm,
  margin: (x: 9mm, top: 11.5mm, bottom: 11mm),
  fill: paper,
  header: context {
    let pg = here().page()
    let hs = query(heading.where(level: 2))
    let on = hs.filter(h => h.location().page() == pg)
    let before = hs.filter(h => h.location().page() < pg)
    let pick = if on.len() > 0 { on.first() } else if before.len() > 0 { before.last() } else { none }
    if pick != none and pick.body != [Appendix] {
      align(right)[
        #text(size: 6.2pt, fill: muted, tracking: 0.14em, smallcaps(pick.body))
      ]
    }
  },
  footer: context align(center)[
    #text(size: 6.8pt, fill: muted, tracking: 0.06em)[
      #counter(page).display("1")
    ]
  ],
)
#set heading(numbering: none)

// ------------------------------------------------------------------ helpers
#let stat = book.stats

#let kicker(body) = text(size: 7pt, fill: muted, tracking: 0.18em, smallcaps(body))
#let hairline(w: 100%, c: rule-c) = line(length: w, stroke: 0.4pt + c)

#let para(size: 9pt, fill: ink, leading: 0.72em, style: "normal", justify: true, body) = block(
  above: 0pt, below: 0pt,
  {
    set text(size: size, fill: fill, style: style)
    set par(leading: leading, justify: justify)
    body
  },
)

#let ornament = align(center)[
  #v(5pt)
  #text(size: 8pt, fill: rule-c, tracking: 0.6em)[· · ·]
  #v(1pt)
]

#let flagged(s) = s.confidence != "high" or s.note != ""

// ------------------------------------------------------------- cover & front
#page(fill: dark, margin: (x: 11mm, top: 15mm, bottom: 12mm), footer: none, header: none)[
  #set text(fill: cream)
  #v(3mm)
  #text(size: 7pt, fill: cream.transparentize(55%), tracking: 0.2em, smallcaps[The Fourth Gospel])
  #v(8mm)
  #block[
    #set par(justify: false)
    #set text(hyphenate: false)
    #text(size: 24pt, weight: "bold", tracking: -0.015em)[The Words of Jesus]
    #v(2.5mm)
    #text(size: 13pt, style: "italic", fill: cream.transparentize(18%))[
      in the Gospel of John
    ]
  ]
  #v(9mm)
  #line(length: 22mm, stroke: 0.6pt + cream.transparentize(45%))
  #v(8mm)
  #para(size: 9.4pt, fill: cream.transparentize(12%), leading: 0.68em)[
    Every sentence the narrative puts in his mouth — the narrator, the crowds,
    the disciples and the voice from heaven all removed. Nothing but what he says,
    in the order he says it.
  ]
  #v(1fr)
  #line(length: 100%, stroke: 0.5pt + cream.transparentize(60%))
  #v(4mm)
  #grid(columns: (1fr, 1fr), column-gutter: 5mm,
    para(size: 7.2pt, fill: cream.transparentize(28%), leading: 0.62em, justify: false)[
      #stat.sayings sayings
      #linebreak()
      #stat.verses verses
      #linebreak()
      21 chapters
    ],
    align(right, para(size: 7.2pt, fill: cream.transparentize(28%), leading: 0.62em, justify: false)[
      World English Bible
      #linebreak()
      public domain
      #linebreak()
      compiled #book.generated
    ]),
  )
]

// method page
#page(footer: none, header: none)[
  #v(2mm)
  #kicker[How to read this]
  #v(4mm)
  #block[
    #set par(justify: false, leading: 0.78em)
    #text(size: 13pt, weight: "bold")[
      This is John's Gospel with everything taken out except Jesus.
    ]
  ]
  #v(4mm)
  #para(size: 9.6pt, leading: 0.75em)[
    Verse numbers sit at the start of each saying so you can find it in any Bible.
    Where a verse also holds narration or another speaker, only his words are printed —
    the number is the handle back to the whole scene.
  ]
  #v(4mm)
  #para(size: 9.6pt, leading: 0.75em)[
    *Excluded:* the narrator's commentary (even where it sounds like him: 1:1–18, 3:31–36,
    7:39, 12:37–43), the Father's voice from heaven, John the Baptist, the disciples, the woman
    at the well, Nicodemus, Martha, Mary, Pilate, the crowds, and the healed blind man.
  ]
  #v(4mm)
  #para(size: 9.6pt, leading: 0.75em)[
    *Included:* questions, commands, one-word answers, quoted Scripture, prayers to the Father,
    and speech after the resurrection. Nothing paraphrased, nothing modernised — only the
    quotation marks were removed.
  ]
  #v(4mm)
  #para(size: 9.6pt, leading: 0.75em)[
    *Marked †:* a line whose attribution or transmission is contested. There are
    #stat.flagged of them; the note under the line says why.
  ]
  #v(5mm)
  #hairline()
  #v(3mm)
  #para(size: 8.2pt, fill: muted, leading: 0.72em)[
    Text: World English Bible, a public-domain modern-English revision of the American Standard
    Version of 1901. #stat.sayings sayings across #stat.verses of John's 879 verses;
    #stat.words words, #stat.avg_words on average.
  ]
]

// numbers page
#page(footer: none, header: none)[
  #kicker[The shape of the speech]
  #v(5mm)
  #let row(label, value) = grid(
    columns: (1fr, auto), column-gutter: 6mm,
    text(size: 9.4pt)[#label],
    text(size: 9.4pt, weight: "bold")[#value],
  )
  #row[Sayings][#stat.sayings]
  #v(1.8mm)
  #row[Verses containing his speech][#stat.verses / 879]
  #v(1.8mm)
  #row[Whole-verse / partial-verse][#stat.full / #stat.partial]
  #v(1.8mm)
  #row[Words spoken][#stat.words]
  #v(1.8mm)
  #row[Longest single saying][#stat.longest_words words]
  #v(1.8mm)
  #row[Average saying][#stat.avg_words words]
  #v(1.8mm)
  #row[Lines marked †][#stat.flagged]
  #v(7mm)
  #hairline()
  #v(5mm)
  #kicker[Words he uses most]
  #v(5mm)
  #grid(columns: (1fr, 1fr), row-gutter: 2.4mm, column-gutter: 6mm,
    ..stat.terms.map(((t, c)) => grid(
      columns: (1fr, auto),
      text(size: 9pt)[#t],
      text(size: 9pt, fill: muted)[#c ×],
    )).flatten(),
  )
  #v(7mm)
  #hairline()
  #v(4mm)
  #para(size: 8.2pt, fill: muted, leading: 0.72em)[
    Counting is mechanical: whitespace-separated tokens in the extracted sayings only.
    It measures the English of one translation, not the Greek.
  ]
]

// contents
#page(footer: none, header: none)[
  #kicker[Contents]
  #v(5mm)
  #let chnum = (n) => context {
    let hs = query(heading.where(level: 2))
    if n <= hs.len() {
      text(size: 8.6pt, fill: muted)[#counter(page).at(hs.at(n - 1).location()).first()]
    }
  }
  #for p in book.parts {
    v(2mm)
    text(size: 8.4pt, weight: "bold", tracking: 0.04em)[Part #p.numeral · #p.title]
    v(1.6mm)
    for ch in p.chapters {
      grid(
        columns: (1fr, auto), column-gutter: 4mm,
        text(size: 8.8pt)[John #ch.n #text(size: 7.6pt, fill: muted)[· #ch.count sayings]],
        chnum(ch.n),
      )
      v(1mm)
    }
    v(1mm)
  }
]

// ------------------------------------------------------------------- parts
#let part-page(p) = page(
  fill: dark, footer: none, header: none, margin: (x: 11mm, top: 22mm, bottom: 12mm),
)[
  #set text(fill: cream)
  #kicker[Part #p.numeral]
  #v(6mm)
  #block[
    #set par(justify: false, leading: 0.85em)
    #text(size: 20pt, weight: "bold")[#p.title]
  ]
  #v(4mm)
  #text(size: 9.4pt, fill: cream.transparentize(25%))[#p.range]
  #v(8mm)
  #line(length: 18mm, stroke: 0.6pt + cream.transparentize(45%))
  #v(6mm)
  #text(size: 7.6pt, fill: cream.transparentize(45%), tracking: 0.04em)[
    #p.chapters.len() chapters ·
    #p.chapters.map(c => c.count).sum() sayings
  ]
]

// ----------------------------------------------------------------- chapters
#show heading.where(level: 2): it => block(above: 11mm, below: 3mm, breakable: false)[
  #kicker[#it.body]
]

#let chapter-head(ch) = block(above: 0pt, below: 6mm, breakable: false, sticky: true)[
  #para(size: 10.2pt, fill: muted, leading: 0.72em, style: "italic")[#ch.summary]
  #v(4mm)
  #hairline()
  #v(5mm)
]

#let run-text(s) = {
  for (i, seg) in s.segs.enumerate() {
    if i > 0 {
      text(size: 6pt, fill: muted, baseline: 0.42em)[#seg.ref.split(":").at(1)]
      h(0.7mm)
    }
    seg.t + " "
  }
}

#let saying(s, repeat: false) = block(above: 0pt, below: 0pt)[
  #text(size: 7.4pt, fill: if repeat { muted.lighten(25%) } else { accent },
    weight: if repeat { "regular" } else { "bold" })[#s.ref]
  #if flagged(s) {
    text(size: 7.4pt, fill: accent)[†]
  }
  #h(1.6mm)
  #run-text(s)
  #{
    let t = s.segs.last().t.trim()
    let closes = (".", "?", "!", "”", "’", ":", ";", "\"" , "'")
    if not closes.any(c => t.ends-with(c)) {
      text(fill: muted.lighten(15%))[ … ]
    }
  }
]

#let chapter-body(ch) = {
  if ch.blocks.len() == 0 {
    text(size: 9pt, fill: muted, style: "italic")[No recorded speech in this chapter.]
  }
  for b in ch.blocks {
    block(above: 4mm, below: 2.6mm, sticky: true)[
      #text(size: 7.4pt, fill: muted, style: "italic")[#b.scene]
    ]
    for (i, s) in b.sayings.enumerate() {
      saying(s, repeat: i > 0 and b.sayings.at(i - 1).ref == s.ref)
      v(2.9mm)
    }
  }
  if ch.notes.len() > 0 {
    v(3mm)
    for n in ch.notes {
      block(above: 2mm, below: 0pt)[
        #text(size: 6.9pt, fill: muted, style: "italic")[
          † #n.label — #n.text
        ]
      ]
    }
  }
  v(2mm)
}

// ------------------------------------------------------------------- body
#counter(page).update(1)

#for p in book.parts {
  part-page(p)
  for ch in p.chapters {
    heading(level: 2, outlined: true)[John #ch.n]
    chapter-head(ch)
    chapter-body(ch)
  }
}

// --------------------------------------------------------------- appendix
#pagebreak(weak: true)
#v(2mm)
#heading(level: 2, outlined: true)[Appendix]
#block[
  #set par(justify: false, leading: 0.8em)
  #text(size: 12pt, weight: "bold")[Words the gospel reports but never speaks in a scene]
]
#v(4mm)
#para(size: 9.2pt, leading: 0.74em)[
  Four times the narrator refers to something Jesus said without putting it in a scene. They are
  speech attributed to him, so they belong in the record, but no red-letter edition prints them
  in red and the main text above leaves them out.
]
#v(6mm)
#for r in book.reported {
  block(above: 3.4mm, below: 0pt)[
    #text(size: 7.4pt, fill: accent, weight: "bold")[#r.ref]
    #h(1.6mm)
    #text(style: "italic")[“#r.quote”]
    #v(1.2mm)
    #text(size: 7.6pt, fill: muted)[#r.why]
  ]
}
#v(6mm)
#hairline()
#v(4mm)

// --------------------------------------------------------------- colophon
#pagebreak()
#kicker[Colophon]
#v(4mm)
#para(size: 9pt, leading: 0.74em)[
  Source text: World English Bible (WEB), public domain, fetched once from bible-api.com and
  stored with this project. Extraction produced #stat.sayings speech units across 21 chapters;
  every one is machine-verified to be a verbatim substring of its verse.
]
#v(3.5mm)
#para(size: 9pt, leading: 0.74em)[
  Verse references follow standard John chapter:verse notation — search a reference in any Bible
  to land in the full scene. Data, verification script and build tooling are public domain.
  Typeset in Charter at 100 × 200 mm for reading on a phone.
]
#v(5mm)
#text(size: 7.6pt, fill: muted)[Compiled #book.generated]
